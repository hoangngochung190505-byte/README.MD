# ỨNG DỤNG SYMPY: BÀI THỂ TÍCH QUANH TRỤC OX

## 1. Mục đích

Chương trình sử dụng để tính thể tích khối tròn xoay tạo thành khi quay hình phẳng quanh trục \(Ox\).

Với hình phẳng giới hạn bởi đồ thị \(y=f(x)\), trục \(Ox\) và hai đường thẳng \(x=a,\ x=b\), thể tích được tính theo công thức:

\[
V=\pi\int_a^b [f(x)]^2\,dx
\]

Chương trình có các chức năng:

- Nhập hàm số \(f(x)\) và hai cận tích phân từ bàn phím.
- Tính thể tích chính xác bằng **SymPy**.
- Hiển thị giá trị thể tích xấp xỉ.
- Cho phép nhập các cận chứa số \(\pi\), ví dụ `pi`, `pi/2`, `2*pi`.
- Vẽ mô hình vật thể tròn xoay trong không gian 3 chiều bằng **NumPy** và **Matplotlib**.

---

## 2. Thư viện sử dụng

```python
import numpy as np
import matplotlib.pyplot as plt
import sympy as sp


import numpy as np
import matplotlib.pyplot as plt
import sympy as sp

# ==========================================
# 1. TÍNH THỂ TÍCH BẰNG SYMPY
# ==========================================
x_sym = sp.symbols('x')

print("--- Bài toán 1. Thể tích khối tròn xoay quay quanh trục Ox ---")
print("Lưu ý: Bạn có thể nhập cận là số (1, 2) hoặc hằng số pi (pi, pi/2, 2*pi)")
print("-" * 65)

try:
    # Nhập hàm số và các cận từ bàn phím
    chuoi_f = input("Nhập hàm số f(x) : ")
    chuoi_a = input("Nhập cận dưới a : ")
    chuoi_b = input("Nhập cận trên b : ")

    # Chuyển đổi sang biểu thức toán học của SymPy
    f_sym = sp.sympify(chuoi_f)
    a_sym = sp.sympify(chuoi_a)
    b_sym = sp.sympify(chuoi_b)

    # Áp dụng công thức:
    # V = pi * tích phân từ a đến b của [f(x)]^2
    bieu_thuc_tich_phan = f_sym**2

    V_sym = sp.pi * sp.integrate(
        bieu_thuc_tich_phan,
        (x_sym, a_sym, b_sym)
    )

    print(
        f"\n-> Biểu thức tích phân: "
        f"V = pi * tích phân từ {a_sym} đến {b_sym} "
        f"của ({bieu_thuc_tich_phan}) dx"
    )

    print(f"-> Thể tích chính xác V = {V_sym}")
    print(f"-> Giá trị xấp xỉ V ≈ {float(V_sym):.4f}")
    print("-" * 65)

    # Chuyển đổi cận sang số thực để vẽ đồ thị 3D
    can_a = float(a_sym)
    can_b = float(b_sym)

    # ==========================================
    # 2. VẼ MÔ HÌNH VẬT THỂ TRÒN XOAY 3D
    # ==========================================

    f_num = sp.lambdify(x_sym, f_sym, 'numpy')

    # Tạo lưới tọa độ
    x_vals = np.linspace(can_a, can_b, 100)
    theta = np.linspace(0, 2 * np.pi, 100)

    X, Theta = np.meshgrid(x_vals, theta)

    # Bán kính tại mỗi vị trí x
    R = np.abs(f_num(X))

    # Tọa độ khi quay quanh trục Ox
    Y = R * np.cos(Theta)
    Z = R * np.sin(Theta)

    fig = plt.figure(figsize=(9, 6))
    ax = fig.add_subplot(111, projection='3d')

    # Vẽ bề mặt vật thể tròn xoay
    surf = ax.plot_surface(
        X, Y, Z,
        cmap='plasma',
        alpha=0.75,
        edgecolor='none'
    )

    # Vẽ hai mặt đáy
    ax.plot_surface(
        np.full_like(X, can_a),
        Y, Z,
        color='gray',
        alpha=0.3
    )

    ax.plot_surface(
        np.full_like(X, can_b),
        Y, Z,
        color='gray',
        alpha=0.3
    )

    # Vẽ trục Ox
    ax.plot(
        [can_a - 0.5, can_b + 0.5],
        [0, 0],
        [0, 0],
        color='black',
        linestyle='--',
        linewidth=2,
        label='Trục Ox'
    )

    plt.title(
        'Bài toán 1. Thể tích khối tròn xoay quay quanh trục Ox',
        fontsize=12,
        fontweight='bold',
        pad=20
    )

    ax.set_xlabel('Trục X')
    ax.set_ylabel('Y')
    ax.set_zlabel('Z')

    ax.legend(loc='upper left')

    fig.colorbar(
        surf,
        ax=ax,
        shrink=0.5,
        aspect=10,
        label='Độ lớn bán kính f(x)' )

    # Giữ tỉ lệ không gian
    ax.set_box_aspect(
        (np.ptp(x_vals), np.ptp(Y), np.ptp(Z)))

    plt.show()

except Exception as e:
    print(f"\nĐã xảy ra lỗi: {e}")
    print(
        "Vui lòng kiểm tra lại biểu thức hàm số "
        "hoặc giá trị cận đã nhập!"
    )
